# Storage & cache (uploaded files, logs, framework cache)
coops-app/storage/
coops-app/bootstrap/cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Server home-dir artifacts (not part of the project)
.bash_logout
.bashrc
.profile
.cache/
.config/
.local/
.npm/
.coops-source-url
.coops-source-subdir
coops-app/.coops-source-url
